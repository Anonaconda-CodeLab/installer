# Security headers for hosts that read a _headers file (Netlify, Cloudflare Pages).
# frame-ancestors stops other sites from embedding this page around the USB prompt.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: usb=(self), camera=(), microphone=(), geolocation=(), interest-cohort=()
